---
// Hero — Bangladesh storefront with feature badges
---

<section class="relative bg-canvas overflow-hidden min-h-[70vh] flex items-center px-6 py-5xl">
  <div class="hero-mesh-gradient"></div>
  <div class="container-custom relative z-10 text-center w-full">

    <!-- Eyebrow -->
    <p class="font-mono text-xs text-gold/70 uppercase tracking-[0.12em] mb-4 fade-up visible">
      Bangladesh's #1 Minifigure Store
    </p>

    <!-- Main title with multi-color gradient -->
    <h1 class="font-sans text-5xl md:text-7xl lg:text-8xl font-bold leading-[1.1] -tracking-[3px] max-w-[900px] mx-auto fade-up visible stagger-1">
      <span class="bg-gradient-to-r from-gold via-red-500 via-purple-500 via-cyan-400 to-gold bg-clip-text text-transparent">JUMANJI VAULT</span>
    </h1>

    <!-- Subtitle -->
    <p class="font-sans text-sm md:text-base text-body/80 max-w-[640px] mx-auto mt-4 leading-relaxed fade-up visible stagger-2">
      Premium LEGO Minifigures — Marvel · DC · Anime · Dragon Ball Z · Stranger Things
    </p>

    <!-- Description -->
    <p class="font-sans text-xs md:text-sm text-mute max-w-[520px] mx-auto mt-2 fade-up visible stagger-2">
      Authentic detail, premium ABS plastic, delivered to your door
    </p>

    <!-- Feature badges -->
    <div class="flex flex-wrap justify-center gap-2 mt-8 fade-up visible stagger-3">
      <span class="font-sans text-[11px] font-medium leading-4 px-3 py-1.5 rounded-lg border border-hairline bg-canvas-soft text-body/80">Cash on Delivery</span>
      <span class="font-sans text-[11px] font-medium leading-4 px-3 py-1.5 rounded-lg border border-hairline bg-canvas-soft text-body/80">~4 cm Premium ABS Plastic</span>
      <span class="font-sans text-[11px] font-medium leading-4 px-3 py-1.5 rounded-lg border border-hairline bg-canvas-soft text-body/80">1–3 Day Delivery</span>
      <span class="font-sans text-[11px] font-medium leading-4 px-3 py-1.5 rounded-lg border border-hairline bg-canvas-soft text-body/80">Accessories Included</span>
    </div>

    <!-- Buttons -->
    <div class="flex flex-wrap items-center justify-center gap-3 mt-8 fade-up visible stagger-4">
      <a href="#products" class="font-sans text-sm font-bold leading-5 px-7 py-3 border-none cursor-pointer rounded-lg no-underline inline-flex items-center gap-2 transition-all duration-300 hover:shadow-glow-gold bg-primary text-on-primary">
        Browse Collection →
      </a>
      <button onclick="document.getElementById('cartToggle')?.click()" class="font-sans text-sm font-medium leading-5 px-7 py-3 border border-hairline cursor-pointer rounded-lg no-underline inline-flex items-center gap-2 transition-all duration-300 hover:border-gold/40 hover:text-gold bg-canvas-soft text-body">
        View Cart
      </button>
    </div>

  </div>
</section>

<style is:global>
  .hero-mesh-gradient {
    position: absolute;
    inset: 0;
    z-index: 0;
    background:
      radial-gradient(ellipse 70% 50% at 15% 15%, rgba(255, 215, 0, 0.08) 0%, transparent 55%),
      radial-gradient(ellipse 55% 60% at 85% 20%, rgba(240, 195, 0, 0.06) 0%, transparent 50%),
      radial-gradient(ellipse 40% 40% at 50% 50%, rgba(255, 215, 0, 0.03) 0%, transparent 45%),
      radial-gradient(ellipse 50% 40% at 20% 80%, rgba(240, 195, 0, 0.03) 0%, transparent 45%);
    opacity: 0.8;
  }

  @media (max-width: 600px) {
    section { min-height: 60vh; }
  }
</style>
