---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout
  title="Admin Dashboard — Jumanji Vault"
  description="Jumanji Vault admin dashboard"
>
  <Nav />

  <div class="min-h-screen bg-canvas">
    <div class="container-custom py-5xl">
      <!-- Header -->
      <div class="flex items-center justify-between mb-8">
        <div>
          <p class="font-mono text-xs text-gold/60 uppercase tracking-[0.1em] mb-1">Dashboard</p>
          <h1 class="font-sans text-2xl md:text-3xl font-bold text-ink -tracking-[1px]">Admin Panel</h1>
        </div>
        <a href="/" class="font-sans text-sm text-body hover:text-gold no-underline transition-colors duration-200">← Back to Store</a>
      </div>

      <!-- Tab Navigation -->
      <div class="flex gap-1 mb-6 border-b border-hairline">
        <button class="tab-btn active px-4 py-2.5 font-sans text-sm text-ink border-b-2 border-gold bg-none cursor-pointer" data-tab="overview">Overview</button>
        <button class="tab-btn px-4 py-2.5 font-sans text-sm text-body border-b-2 border-transparent bg-none cursor-pointer hover:text-ink transition-colors duration-200" data-tab="products">Products</button>
        <button class="tab-btn px-4 py-2.5 font-sans text-sm text-body border-b-2 border-transparent bg-none cursor-pointer hover:text-ink transition-colors duration-200" data-tab="orders">Orders</button>
        <button class="tab-btn px-4 py-2.5 font-sans text-sm text-body border-b-2 border-transparent bg-none cursor-pointer hover:text-ink transition-colors duration-200" data-tab="settings">Settings</button>
        <button class="tab-btn px-4 py-2.5 font-sans text-sm text-body border-b-2 border-transparent bg-none cursor-pointer hover:text-ink transition-colors duration-200" data-tab="categories">Categories</button>
      </div>

      <!-- ===== OVERVIEW TAB ===== -->
      <div class="tab-content" id="tab-overview">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-8">
          <div class="bg-canvas-soft-2 rounded-lg border border-hairline p-4">
            <p class="font-mono text-[11px] text-mute uppercase tracking-[0.06em] mb-1">Total Products</p>
            <p id="statProducts" class="font-sans text-2xl font-bold text-ink">0</p>
          </div>
          <div class="bg-canvas-soft-2 rounded-lg border border-hairline p-4">
            <p class="font-mono text-[11px] text-mute uppercase tracking-[0.06em] mb-1">Orders</p>
            <p id="statOrders" class="font-sans text-2xl font-bold text-gold">0</p>
          </div>
          <div class="bg-canvas-soft-2 rounded-lg border border-hairline p-4">
            <p class="font-mono text-[11px] text-mute uppercase tracking-[0.06em] mb-1">Revenue</p>
            <p id="statRevenue" class="font-sans text-2xl font-bold text-green-400">৳0</p>
          </div>
          <div class="bg-canvas-soft-2 rounded-lg border border-hairline p-4">
            <p class="font-mono text-[11px] text-mute uppercase tracking-[0.06em] mb-1">Cart Items</p>
            <p id="statCart" class="font-sans text-2xl font-bold text-cyan-400">0</p>
          </div>
        </div>
      </div>

      <!-- ===== PRODUCTS TAB ===== -->
      <div class="tab-content hidden" id="tab-products">
        <div class="flex items-center justify-between mb-4">
          <h2 class="font-sans text-base font-semibold text-ink">Product Catalog</h2>
          <button id="addProductBtn" class="font-sans text-sm font-medium px-4 py-2 rounded-lg border-none cursor-pointer transition-all duration-200 hover:shadow-glow-gold-sm bg-primary text-on-primary">+ Add Product</button>
        </div>
        <div class="bg-canvas-soft-2 rounded-lg border border-hairline overflow-hidden">
          <div class="overflow-x-auto">
            <table class="w-full text-sm">
              <thead>
                <tr class="border-b border-hairline">
                  <th class="text-left px-4 py-3 font-mono text-[11px] text-mute uppercase tracking-[0.05em]">Product</th>
                  <th class="text-left px-4 py-3 font-mono text-[11px] text-mute uppercase tracking-[0.05em]">Category</th>
                  <th class="text-left px-4 py-3 font-mono text-[11px] text-mute uppercase tracking-[0.05em]">Price</th>
                  <th class="text-right px-4 py-3 font-mono text-[11px] text-mute uppercase tracking-[0.05em]">Actions</th>
                </tr>
              </thead>
              <tbody id="productTableBody"></tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- ===== ORDERS TAB ===== -->
      <div class="tab-content hidden" id="tab-orders">
        <div class="flex items-center justify-between mb-4">
          <h2 class="font-sans text-base font-semibold text-ink">Order History</h2>
          <button id="clearOrdersBtn" class="font-sans text-xs text-mute hover:text-red-400 bg-none border-none cursor-pointer transition-colors duration-200">Clear All</button>
        </div>
        <div id="ordersList" class="space-y-2">
          <p class="text-body text-sm text-center py-8">No orders yet.</p>
        </div>
      </div>

      <!-- ===== SETTINGS TAB ===== -->
      <div class="tab-content hidden" id="tab-settings">
        <h2 class="font-sans text-base font-semibold text-ink mb-4">Store Settings</h2>
        <p class="text-body text-xs mb-5">Edit your payment and contact info below. These values will be used across the store.</p>

        <div class="bg-canvas-soft-2 rounded-lg border border-hairline p-5 max-w-lg space-y-4">
          <div>
            <label class="font-mono text-[11px] text-mute uppercase tracking-[0.05em] block mb-1.5">bKash Number</label>
            <input id="setBkash" type="text" placeholder="e.g. 01XXXXXXXXX" class="w-full h-10 px-3 rounded-lg border border-hairline bg-canvas text-ink text-sm outline-none focus:border-gold/50 transition-colors duration-200" />
          </div>
          <div>
            <label class="font-mono text-[11px] text-mute uppercase tracking-[0.05em] block mb-1.5">Nagad Number</label>
            <input id="setNagad" type="text" placeholder="e.g. 01XXXXXXXXX" class="w-full h-10 px-3 rounded-lg border border-hairline bg-canvas text-ink text-sm outline-none focus:border-gold/50 transition-colors duration-200" />
          </div>
          <div>
            <label class="font-mono text-[11px] text-mute uppercase tracking-[0.05em] block mb-1.5">Contact Number</label>
            <input id="setContact" type="text" placeholder="e.g. 01XXXXXXXXX" class="w-full h-10 px-3 rounded-lg border border-hairline bg-canvas text-ink text-sm outline-none focus:border-gold/50 transition-colors duration-200" />
          </div>
          <div>
            <label class="font-mono text-[11px] text-mute uppercase tracking-[0.05em] block mb-1.5">Email Address</label>
            <input id="setEmail" type="email" placeholder="e.g. hello@jumanjivault.com" class="w-full h-10 px-3 rounded-lg border border-hairline bg-canvas text-ink text-sm outline-none focus:border-gold/50 transition-colors duration-200" />
          </div>
          <div>
            <label class="font-mono text-[11px] text-mute uppercase tracking-[0.05em] block mb-1.5">Delivery Address</label>
            <textarea id="setAddress" rows="2" placeholder="Store address for returns/contact" class="w-full px-3 py-2 rounded-lg border border-hairline bg-canvas text-ink text-sm outline-none focus:border-gold/50 transition-colors duration-200 resize-none"></textarea>
          </div>
          <button id="saveSettingsBtn" class="font-sans text-sm font-medium px-5 py-2.5 rounded-lg border-none cursor-pointer transition-all duration-200 hover:shadow-glow-gold-sm bg-primary text-on-primary">Save Settings</button>
          <p id="settingsStatus" class="text-xs text-green-400 hidden">Settings saved successfully!</p>
        </div>
      </div>

      <!-- ===== CATEGORIES TAB ===== -->
      <div class="tab-content hidden" id="tab-categories">
        <div class="flex items-center justify-between mb-4">
          <h2 class="font-sans text-base font-semibold text-ink">Product Categories</h2>
        </div>
        <div class="bg-canvas-soft-2 rounded-lg border border-hairline p-5 max-w-lg">
          <div class="flex gap-2 mb-5">
            <input id="newCategoryInput" type="text" placeholder="New category name..." class="flex-1 h-10 px-3 rounded-lg border border-hairline bg-canvas text-ink text-sm outline-none focus:border-gold/50 transition-colors duration-200" />
            <button id="addCategoryBtn" class="font-sans text-sm font-medium px-4 py-2 rounded-lg border-none cursor-pointer transition-all duration-200 hover:shadow-glow-gold-sm bg-primary text-on-primary whitespace-nowrap">+ Add</button>
          </div>
          <p class="font-mono text-[11px] text-mute uppercase tracking-[0.05em] mb-3">Current Categories</p>
          <div id="categoriesList" class="space-y-2"></div>
        </div>
      </div>
    </div>
  </div>

  <!-- Product Modal -->
  <div id="productModal" class="fixed inset-0 z-[300] hidden items-center justify-center bg-black/60">
    <div class="bg-canvas rounded-xl border border-hairline p-6 w-full max-w-md mx-4">
      <div class="flex items-center justify-between mb-4">
        <h3 id="modalTitle" class="font-sans text-base font-semibold text-ink">Add Product</h3>
        <button id="modalClose" class="text-body hover:text-ink text-lg leading-none cursor-pointer bg-none border-none p-1">&times;</button>
      </div>
      <div class="space-y-3">
        <div>
          <label class="font-mono text-[11px] text-mute uppercase tracking-[0.05em] block mb-1">Product Name</label>
          <input id="modalName" type="text" class="w-full h-10 px-3 rounded-lg border border-hairline bg-canvas-soft text-ink text-sm outline-none focus:border-gold/50" />
        </div>          <div>
            <label class="font-mono text-[11px] text-mute uppercase tracking-[0.05em] block mb-1">Category</label>
            <select id="modalCategory" class="w-full h-10 px-3 rounded-lg border border-hairline bg-canvas-soft text-ink text-sm outline-none focus:border-gold/50">
            </select>
          </div>
        <div>
          <label class="font-mono text-[11px] text-mute uppercase tracking-[0.05em] block mb-1">Price (with ৳)</label>
          <input id="modalPrice" type="text" placeholder="e.g. ৳4,500" class="w-full h-10 px-3 rounded-lg border border-hairline bg-canvas-soft text-ink text-sm outline-none focus:border-gold/50" />
        </div>          <div>
            <label class="font-mono text-[11px] text-mute uppercase tracking-[0.05em] block mb-1">Image</label>
            <div class="flex gap-2 mb-2">
              <input id="modalImage" type="text" placeholder="Image URL (optional)" class="flex-1 h-10 px-3 rounded-lg border border-hairline bg-canvas-soft text-ink text-sm outline-none focus:border-gold/50" />
              <label class="flex-shrink-0 h-10 px-3 rounded-lg border border-hairline bg-canvas text-body hover:text-ink text-sm cursor-pointer flex items-center gap-1.5 transition-colors duration-200">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                Upload
                <input id="modalImageUpload" type="file" accept="image/*" class="hidden" />
              </label>
            </div>
            <div id="imagePreview" class="hidden">
              <img id="imagePreviewImg" src="" alt="Preview" class="w-14 h-14 rounded object-cover border border-hairline" />
            </div>
          </div>
      </div>
      <div class="flex gap-2 mt-5">
        <button id="modalSave" class="flex-1 font-sans text-sm font-medium py-2.5 rounded-lg border-none cursor-pointer transition-all duration-200 hover:shadow-glow-gold-sm bg-primary text-on-primary">Save</button>
        <button id="modalCancel" class="flex-1 font-sans text-sm font-medium py-2.5 rounded-lg border border-hairline cursor-pointer transition-all duration-200 bg-canvas text-body hover:text-ink">Cancel</button>
      </div>
    </div>
  </div>

  <Footer />

  <script>
    (function() {
      'use strict';

      const PRODS_KEY = 'jumanji_products';
      const CART_KEY = 'jumanji_cart';
      const ORDERS_KEY = 'jumanji_orders';
      const SETTINGS_KEY = 'jumanji_settings';
      const CATEGORIES_KEY = 'jumanji_categories';

      const defaultCategories = ['City', 'Star Wars', 'Technic', 'Classic', 'Friends', 'Marvel', 'DC', 'Anime'];

      // ─── Default Products ──────────────────────────────
      const defaultProducts = [
        { name: 'Police Station', category: 'City', categoryLabel: 'City', price: '৳4,500', imageUrl: 'https://images.unsplash.com/photo-1587654780291-39c9404d746b?w=400&h=400&fit=crop&q=80' },
        { name: 'Millennium Falcon 7531', category: 'star-wars', categoryLabel: 'Star Wars', price: '৳12,900', imageUrl: 'https://images.unsplash.com/photo-1605899435973-ca2d1a8431cf?w=400&h=400&fit=crop&q=80' },
        { name: 'Porsche 911 GT3 RS', category: 'technic', categoryLabel: 'Technic', price: '৳28,500', imageUrl: 'https://images.unsplash.com/photo-1494976388531-d1058494cdd8?w=400&h=400&fit=crop&q=80' },
        { name: 'Fire Station & Truck', category: 'city', categoryLabel: 'City', price: '৳3,800', imageUrl: 'https://images.unsplash.com/photo-1558618666-fcd25c85f82e?w=400&h=400&fit=crop&q=80' },
        { name: 'Creative Classic Box', category: 'classic', categoryLabel: 'Classic', price: '৳2,900', imageUrl: 'https://images.unsplash.com/photo-1589825746001-0e9e9e8f5a0a?w=400&h=400&fit=crop&q=80' },
        { name: 'Heartlake City Set', category: 'friends', categoryLabel: 'Friends', price: '৳5,200', imageUrl: 'https://images.unsplash.com/photo-1618336753974-aae8e04506aa?w=400&h=400&fit=crop&q=80' },
        { name: 'Hydraulic Bulldozer', category: 'technic', categoryLabel: 'Technic', price: '৳19,900', imageUrl: 'https://images.unsplash.com/photo-1530047197337-9b7b4e0b1b0e?w=400&h=400&fit=crop&q=80' },
        { name: 'Death Star 75188', category: 'star-wars', categoryLabel: 'Star Wars', price: '৳15,500', imageUrl: 'https://images.unsplash.com/photo-1534100515-f0d4f0f3b70e?w=400&h=400&fit=crop&q=80' },
      ];

      function getProducts() {
        try {
          const stored = localStorage.getItem(PRODS_KEY);
          if (stored) return JSON.parse(stored);
        } catch {}
        // Seed defaults on first visit
        localStorage.setItem(PRODS_KEY, JSON.stringify(defaultProducts));
        return [...defaultProducts];
      }

      function saveProducts(prods) {
        localStorage.setItem(PRODS_KEY, JSON.stringify(prods));
        // Dispatch event for product grid to update
        window.dispatchEvent(new CustomEvent('products-updated'));
      }

      function getCart() {
        try { return JSON.parse(localStorage.getItem(CART_KEY)) || []; }
        catch { return []; }
      }

      function getOrders() {
        try { return JSON.parse(localStorage.getItem(ORDERS_KEY)) || []; }
        catch { return []; }
      }

      function getSettings() {
        try { return JSON.parse(localStorage.getItem(SETTINGS_KEY)) || {}; }
        catch { return {}; }
      }

      function getCategories() {
        try {
          const stored = localStorage.getItem(CATEGORIES_KEY);
          if (stored) {
            const parsed = JSON.parse(stored);
            if (Array.isArray(parsed) && parsed.length > 0) return parsed;
          }
        } catch {}
        localStorage.setItem(CATEGORIES_KEY, JSON.stringify(defaultCategories));
        return [...defaultCategories];
      }

      function saveCategories(cats) {
        localStorage.setItem(CATEGORIES_KEY, JSON.stringify(cats));
        window.dispatchEvent(new CustomEvent('categories-updated'));
      }

      function fmtPrice(num) {
        return '৳' + num.toLocaleString('en-IN');
      }

      // ─── Tab Switching ─────────────────────────────────
      document.querySelectorAll('.tab-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          document.querySelectorAll('.tab-btn').forEach(b => {
            b.classList.remove('active', 'text-ink', 'border-gold');
            b.classList.add('text-body', 'border-transparent');
          });
          btn.classList.add('active', 'text-ink', 'border-gold');
          btn.classList.remove('text-body', 'border-transparent');
          document.querySelectorAll('.tab-content').forEach(tc => tc.classList.add('hidden'));
          document.getElementById('tab-' + btn.dataset.tab)?.classList.remove('hidden');
        });
      });

      // ─── Stats ─────────────────────────────────────────
      function updateStats() {
        const prods = getProducts();
        const orders = getOrders();
        const cart = getCart();
        document.getElementById('statProducts').textContent = prods.length;
        document.getElementById('statOrders').textContent = orders.length;
        document.getElementById('statRevenue').textContent = fmtPrice(orders.reduce((s, o) => s + (o.total || 0), 0));
        document.getElementById('statCart').textContent = cart.reduce((s, i) => s + (i.qty || 1), 0);
      }

      // ─── Product Table ─────────────────────────────────
      function renderProducts() {
        const prods = getProducts();
        const tbody = document.getElementById('productTableBody');
        if (prods.length === 0) {
          tbody.innerHTML = '<tr><td colspan="4" class="text-center py-8 text-body text-sm">No products. Click "Add Product" to get started.</td></tr>';
          return;
        }
        tbody.innerHTML = prods.map((p, i) => `
          <tr class="border-b border-hairline/50">
            <td class="px-4 py-3 flex items-center gap-2">
              <img src="${p.imageUrl}" alt="" class="w-8 h-8 rounded object-cover" />
              <span class="text-ink font-medium text-sm">${p.name}</span>
            </td>
            <td class="px-4 py-3 text-body text-sm">${p.categoryLabel || p.category}</td>
            <td class="px-4 py-3 text-gold font-semibold text-sm">${p.price}</td>
            <td class="px-4 py-3 text-right">
              <button class="edit-prod font-sans text-xs text-body hover:text-gold bg-none border-none cursor-pointer mr-3 transition-colors" data-idx="${i}">Edit</button>
              <button class="del-prod font-sans text-xs text-mute hover:text-red-400 bg-none border-none cursor-pointer transition-colors" data-idx="${i}">Delete</button>
            </td>
          </tr>
        `).join('');

        tbody.querySelectorAll('.edit-prod').forEach(btn => {
          btn.addEventListener('click', () => openProductModal(parseInt(btn.dataset.idx)));
        });
        tbody.querySelectorAll('.del-prod').forEach(btn => {
          btn.addEventListener('click', () => {
            if (confirm('Delete this product?')) {
              const prods = getProducts();
              prods.splice(parseInt(btn.dataset.idx), 1);
              saveProducts(prods);
              renderProducts();
              updateStats();
            }
          });
        });
      }

      // ─── Product Modal ─────────────────────────────────
      let editIdx = -1;
      function openProductModal(idx) {
        editIdx = idx;
        const modal = document.getElementById('productModal');
        const title = document.getElementById('modalTitle');
        const preview = document.getElementById('imagePreview');
        const previewImg = document.getElementById('imagePreviewImg');
        if (idx >= 0) {
          const p = getProducts()[idx];
          title.textContent = 'Edit Product';
          document.getElementById('modalName').value = p.name;
          document.getElementById('modalCategory').value = p.categoryLabel || p.category;
          document.getElementById('modalPrice').value = p.price;
          document.getElementById('modalImage').value = p.imageUrl;
          if (p.imageUrl) {
            previewImg.src = p.imageUrl;
            preview.classList.remove('hidden');
          } else {
            preview.classList.add('hidden');
          }
        } else {
          title.textContent = 'Add Product';
          document.getElementById('modalName').value = '';
          const cats = getCategories();
          document.getElementById('modalCategory').value = cats.length > 0 ? cats[0] : '';
          document.getElementById('modalPrice').value = '';
          document.getElementById('modalImage').value = '';
          preview.classList.add('hidden');
        }
        modal.classList.remove('hidden');
        modal.classList.add('flex');
      }

      function closeProductModal() {
        const modal = document.getElementById('productModal');
        modal.classList.add('hidden');
        modal.classList.remove('flex');
        editIdx = -1;
        document.getElementById('modalImageUpload').value = '';
      }

      document.getElementById('addProductBtn')?.addEventListener('click', () => openProductModal(-1));
      document.getElementById('modalClose')?.addEventListener('click', closeProductModal);
      document.getElementById('modalCancel')?.addEventListener('click', closeProductModal);
      document.getElementById('productModal')?.addEventListener('click', (e) => {
        if (e.target === e.currentTarget) closeProductModal();
      });

      document.getElementById('modalSave')?.addEventListener('click', () => {
        const name = document.getElementById('modalName').value.trim();
        const cat = document.getElementById('modalCategory').value;
        const price = document.getElementById('modalPrice').value.trim();
        const img = document.getElementById('modalImage').value.trim();
        if (!name || !price) { alert('Name and price are required.'); return; }

        const prods = getProducts();
        const catKey = cat.toLowerCase().replace(/\s+/g, '-');
        const product = { name, category: catKey, categoryLabel: cat, price, imageUrl: img || 'https://images.unsplash.com/photo-1587654780291-39c9404d746b?w=400&h=400&fit=crop&q=80' };

        if (editIdx >= 0) {
          prods[editIdx] = product;
        } else {
          prods.push(product);
        }
        saveProducts(prods);
        renderProducts();
        updateStats();
        closeProductModal();
      });

      // ─── Orders ────────────────────────────────────────
      function renderOrders() {
        const container = document.getElementById('ordersList');
        const orders = getOrders();
        if (orders.length === 0) {
          container.innerHTML = '<p class="text-body text-sm text-center py-8">No orders yet.</p>';
          return;
        }
        container.innerHTML = orders.slice().reverse().map((order, i) => {
          const delivery = order.delivery || {};
          return `<div class="bg-canvas-soft-2 rounded-lg border border-hairline p-4">
            <div class="flex items-center justify-between mb-2">
              <span class="font-mono text-xs text-mute">#${orders.length - i}</span>
              <span class="text-sm text-gold font-bold">${fmtPrice(order.total || 0)}</span>
            </div>
            <div class="text-xs text-body space-y-0.5 mb-2">
              <p><strong class="text-ink">${delivery.name || '—'}</strong> · ${delivery.phone || '—'}</p>
              <p>${delivery.address || ''}${delivery.city ? ', ' + delivery.city : ''}</p>
              <p>Payment: ${delivery.payment || '—'}</p>
            </div>
            <p class="text-[11px] text-mute">${(order.items || []).map(item => item.name + ' x' + (item.qty||1)).join(', ')}</p>
            <p class="text-[11px] text-mute mt-1">${new Date(order.date || Date.now()).toLocaleDateString('en-BD')}</p>
          </div>`;
        }).join('');
      }

      document.getElementById('clearOrdersBtn')?.addEventListener('click', () => {
        if (confirm('Clear all order records?')) {
          localStorage.removeItem(ORDERS_KEY);
          renderOrders();
          updateStats();
        }
      });

      // ─── Settings ──────────────────────────────────────
      function loadSettings() {
        const s = getSettings();
        document.getElementById('setBkash').value = s.bkash || '';
        document.getElementById('setNagad').value = s.nagad || '';
        document.getElementById('setContact').value = s.contact || '';
        document.getElementById('setEmail').value = s.email || '';
        document.getElementById('setAddress').value = s.address || '';
      }

      document.getElementById('saveSettingsBtn')?.addEventListener('click', () => {
        const settings = {
          bkash: document.getElementById('setBkash').value.trim(),
          nagad: document.getElementById('setNagad').value.trim(),
          contact: document.getElementById('setContact').value.trim(),
          email: document.getElementById('setEmail').value.trim(),
          address: document.getElementById('setAddress').value.trim(),
        };
        localStorage.setItem(SETTINGS_KEY, JSON.stringify(settings));
        const status = document.getElementById('settingsStatus');
        status.classList.remove('hidden');
        setTimeout(() => status.classList.add('hidden'), 2500);
        // Dispatch event for other pages
        window.dispatchEvent(new CustomEvent('settings-updated'));
      });

      // ─── Categories ────────────────────────────────────
      function renderCategories() {
        const cats = getCategories();
        const list = document.getElementById('categoriesList');
        if (cats.length === 0) {
          list.innerHTML = '<p class="text-body text-xs text-center py-4">No categories. Add one above.</p>';
          return;
        }
        list.innerHTML = cats.map((cat, i) => `
          <div class="flex items-center justify-between bg-canvas rounded-lg border border-hairline px-3 py-2">
            <span class="text-sm text-ink font-medium">${cat}</span>
            <button class="del-cat font-sans text-xs text-mute hover:text-red-400 bg-none border-none cursor-pointer transition-colors duration-200" data-idx="${i}">Delete</button>
          </div>
        `).join('');

        list.querySelectorAll('.del-cat').forEach(btn => {
          btn.addEventListener('click', () => {
            const cats = getCategories();
            cats.splice(parseInt(btn.dataset.idx), 1);
            saveCategories(cats);
            renderCategories();
            populateCategoryDropdown();
          });
        });
      }

      function populateCategoryDropdown() {
        const cats = getCategories();
        const sel = document.getElementById('modalCategory');
        if (!sel) return;
        sel.innerHTML = cats.map(c => `<option value="${c}">${c}</option>`).join('');
      }

      document.getElementById('addCategoryBtn')?.addEventListener('click', () => {
        const input = document.getElementById('newCategoryInput');
        const name = input.value.trim();
        if (!name) { alert('Please enter a category name.'); return; }
        const cats = getCategories();
        if (cats.some(c => c.toLowerCase() === name.toLowerCase())) {
          alert('Category already exists.');
          return;
        }
        cats.push(name);
        saveCategories(cats);
        renderCategories();
        populateCategoryDropdown();
        input.value = '';
      });

      document.getElementById('newCategoryInput')?.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') document.getElementById('addCategoryBtn')?.click();
      });

      // ─── Image Upload ───────────────────────────────────
      document.getElementById('modalImageUpload')?.addEventListener('change', function() {
        const file = this.files?.[0];
        if (!file) return;
        const reader = new FileReader();
        reader.onload = function(e) {
          const dataUrl = e.target?.result;
          if (typeof dataUrl === 'string') {
            document.getElementById('modalImage').value = dataUrl;
            const preview = document.getElementById('imagePreview');
            const img = document.getElementById('imagePreviewImg');
            img.src = dataUrl;
            preview.classList.remove('hidden');
          }
        };
        reader.readAsDataURL(file);
      });

      document.getElementById('modalImage')?.addEventListener('input', function() {
        const preview = document.getElementById('imagePreview');
        if (this.value) {
          document.getElementById('imagePreviewImg').src = this.value;
          preview.classList.remove('hidden');
        } else {
          preview.classList.add('hidden');
        }
      });

      // ─── Init ──────────────────────────────────────────
      renderProducts();
      renderOrders();
      updateStats();
      loadSettings();
      renderCategories();
      populateCategoryDropdown();
    })();
  </script>
</BaseLayout>
